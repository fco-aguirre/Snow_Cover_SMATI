'slope','aspect','zenith','cloud_mask')
plot(high_atk_GLS_t)
#extract projection
crs_1 <- crs(high_atk_GLS$band_1)
high_atk_GLS_t_f <- rast(high_atk_GLS_t$band_1, high_atk_GLS_t$band_2, high_atk_GLS_t$band_3,
high_atk_GLS_t$band_4, high_atk_GLS_t$band_5, high_atk_GLS_t$band_6,
high_atk_GLS_t$band_7)
high_atk_GLS_t_f <- c(high_atk_GLS_t$band_1, high_atk_GLS_t$band_2, high_atk_GLS_t$band_3,
high_atk_GLS_t$band_4, high_atk_GLS_t$band_5, high_atk_GLS_t$band_6,
