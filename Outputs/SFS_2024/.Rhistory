em_names <- c("water", "land")
pts <- data.frame(class=em_names, cell = c(47916,5294))
em <- lsat[pts$cell]
View(pts)
View(em)
rownames(em) <- em_names
#unmix the image for water and land
probs <- mesma(lsat, em, method = "NNLS")
plot(probs)
